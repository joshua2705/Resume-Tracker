# Copy to .env and fill in. Leave blank to run that feature offline (mock/heuristic).

# LlamaParse (LlamaCloud) — real resume PDF parsing.
LLAMA_CLOUD_API_KEY=

# Gemini (Google AI Studio) — scoring, interview questions, AI coach.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

USER_NAME=Joshua
FRONTEND_ORIGIN=http://localhost:5173

# --------------------------------------------------------------------------- #
# AGENTIC LAYER (LangGraph). Everything below is optional.
# --------------------------------------------------------------------------- #

# Master switch. When false (or deps/keys missing) the app uses the existing
# heuristic/Gemini path. The agents reuse GEMINI_API_KEY above as their LLM.
AGENTS_ENABLED=true

# --- LangSmith (tracing & logging of every agent run) ---------------------- #
# Get a key at https://smith.langchain.com → Settings → API Keys.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resume-tracker

# --- Gmail MCP (daily inbox → tracker auto-update) ------------------------- #
# Uses @gongrzhe/server-gmail-autoauth-mcp over stdio. Requires Node/npx and a
# one-time OAuth (see backend/app/skills/gmail_tracking/SKILL.md). The command
# is configurable so you can point it at your own Gmail MCP instead.
GMAIL_MCP_ENABLED=false
GMAIL_MCP_COMMAND=npx
GMAIL_MCP_ARGS=-y,@gongrzhe/server-gmail-autoauth-mcp
# Run the inbox scan automatically once per day inside the backend process.
GMAIL_DAILY_SCAN=false
GMAIL_SCAN_LOOKBACK_DAYS=1

# --- Guardrails (chat) ----------------------------------------------------- #
COACH_MAX_INPUT_CHARS=4000
# Daily token budget per user for the coach (input+output, estimated).
COACH_DAILY_TOKEN_BUDGET=200000
COACH_MAX_REQUESTS_PER_MIN=12
